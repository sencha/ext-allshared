{
  "name": "ext-allshared",
  "version": "7.0.1",
  "description": "All Shared packages for ext-* tools",
  "main": "index.js",
  "scripts": {
    "preinstall": "npx npm-force-resolutions",
    "postinstall": "npx lerna bootstrap --loglevel warn",
    "increment": "npx lerna publish --skip-git --skip-npm --force-publish",
    "clean": "npx lerna clean",
    "install:clean": "npm cache clear --force && npx lerna clean && npm install"
  },
  "keywords": [
    "Ext",
    "JS",
    "Sencha"
  ],
  "author": "Sencha, Inc.",
  "license": "MIT",
  "devDependencies": {
    "lerna": "6.6.2",
    "npm-force-resolutions": "^0.0.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sencha/ext-allshared"
  },
  "resolutions": {
    "semver": "7.6.3",
    "tar": "7.4.3"
  },
  "dependencies": {
    "@isaacs/fs-minipass": "^4.0.1"
  }
}
